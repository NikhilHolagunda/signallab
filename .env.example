# ??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
# SignalLab ??? copy to `.env` in the repo root:   cp .env.example .env
# docker compose reads it; the backend/worker read the same names when run
# outside Docker. Only JWT_SECRET is required.
# ??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????

# ?????? Auth (backend) ????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
# REQUIRED. HS256 signing secret, >= 32 bytes:  openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# true in production (HTTPS) so the refresh cookie is Secure.
COOKIE_SECURE=false
# Origins allowed to call the API directly (the Next.js app proxies /api, so
# this only matters if you point a browser straight at :8080).
CORS_ORIGINS=http://localhost:3000

# ?????? Postgres 16 + pgvector ????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
POSTGRES_USER=signallab
POSTGRES_PASSWORD=signallab
POSTGRES_PORT=5433
# Used by `./gradlew bootRun` outside Docker:
DATABASE_URL=jdbc:postgresql://localhost:5433/signallab
DATABASE_USER=signallab
DATABASE_PASSWORD=signallab

# ?????? n8n ?????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
N8N_PORT=5678
# Encrypts credentials stored in n8n. Set once, never change.
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
# Re-import + publish n8n/workflows/*.json on every n8n start (repo = source of truth).
SIGNALLAB_IMPORT_WORKFLOWS=true
# Backend -> n8n webhook (outside Docker):
N8N_WEBHOOK_URL=http://localhost:5678/webhook/signallab-ingest
# n8n -> backend callback base (outside Docker the backend is on the host):
INGEST_CALLBACK_BASE_URL=http://host.docker.internal:8080
# Fail jobs whose callback never arrives after this long.
INGEST_TIMEOUT=20m
# Regex of accepted reel URLs. Blank = Instagram reels/posts only.
ALLOWED_REEL_URL_PATTERN=

# ?????? LLM extraction (runs inside n8n) ??????????????????????????????????????????????????????????????????????????????????????????????????????
# auto = Ollama if reachable with the model pulled, else Anthropic, else
# OpenAI, else a keyword heuristic (flagged "degraded" in the UI).
LLM_PROVIDER=auto
# Native Ollama on the host (default) or http://ollama:11434 with --profile ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ?????? Media worker (yt-dlp + Whisper + embeddings) ??????????????????????????????????????????????????????????????????
WORKER_PORT=8001
# Outside Docker:
WORKER_URL=http://localhost:8001
# Optional shared secret between n8n/backend and the worker.
WORKER_TOKEN=
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# cpu | cuda
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MIN_SPEECH_WORDS=8
# Instagram usually needs a logged-in session. Export cookies.txt from your
# browser to infra/secrets/cookies.txt and set:
YTDLP_COOKIES_FILE=
# YTDLP_COOKIES_FILE=/secrets/cookies.txt

# ?????? GitHub stars import ?????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
# Optional; lifts the 60 req/h unauthenticated limit.
GITHUB_TOKEN=
GITHUB_MAX_PAGES=10

# ?????? Graph ???????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
GRAPH_SIMILARITY_THRESHOLD=0.45
GRAPH_MAX_NEIGHBORS=6

# ?????? Ports ???????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
BACKEND_PORT=8080
FRONTEND_PORT=3000
