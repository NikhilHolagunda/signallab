# ──────────────────────────────────────────────────────────────
# SignalLab configuration. Copy to `.env` (repo root) and edit.
# Every variable is optional — the defaults boot a fully local stack.
# ──────────────────────────────────────────────────────────────

# --- Storage -------------------------------------------------
# Folder for the SQLite DB, downloaded media and generated sandboxes.
SIGNALLAB_DATA_DIR=./data
# Keep downloaded reel audio/video after transcription (true/false).
KEEP_MEDIA=false

# --- Download (yt-dlp) ----------------------------------------
# Instagram often requires a logged-in session for reels. Point yt-dlp at
# your browser's cookies (chrome | firefox | edge | brave | safari) ...
YTDLP_COOKIES_FROM_BROWSER=
# ... or at an exported Netscape cookies.txt file.
YTDLP_COOKIES_FILE=

# --- Transcription (faster-whisper) ---------------------------
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# cpu | cuda | auto
WHISPER_DEVICE=cpu
# int8 (CPU) | float16 (GPU) | int8_float16
WHISPER_COMPUTE_TYPE=int8
# Fewer words than this => treated as music-only / no speech.
MIN_SPEECH_WORDS=8

# --- LLM extraction -------------------------------------------
# auto = try Ollama, then Anthropic, then OpenAI, then a heuristic fallback.
# Force one with: ollama | anthropic | openai | heuristic
LLM_PROVIDER=auto
OLLAMA_HOST=http://localhost:11434
# llama3.1:8b or qwen2.5:7b both work well.
OLLAMA_MODEL=llama3.1:8b

# Cloud fallbacks — only used if Ollama is unreachable (or forced above).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings -----------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Graph ----------------------------------------------------
# Cosine similarity needed to draw an edge between two nodes.
GRAPH_SIMILARITY_THRESHOLD=0.45
# Max similarity edges per node (keeps the graph from becoming a hairball).
GRAPH_MAX_NEIGHBORS=6

# --- GitHub stars import --------------------------------------
# Optional. Without it you get 60 unauthenticated requests/hour.
GITHUB_TOKEN=

# --- Server ---------------------------------------------------
# Comma-separated origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
# Number of concurrent ingest workers (Whisper is CPU-heavy; keep at 1 on laptops).
WORKER_CONCURRENCY=1

# --- Frontend (Next.js) ---------------------------------------
# Where the Next.js dev server proxies /api/* to.
BACKEND_URL=http://localhost:8000
